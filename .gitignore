node_modules
.pnpm-store
.turbo
dist
.wrangler
*.tsbuildinfo
.eslintcache
.DS_Store
*.log
coverage

# secrets — wrangler dev vars + dotenv (examples stay tracked)
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# playwright
test-results
playwright-report
playwright/.cache

# react-email preview cache
.react-email

# Chrome extension signing key (never commit the private key) + store zip
apps/extension/.keys/*
!apps/extension/.keys/README.md
apps/extension/*.zip

# lockfiles — pnpm only
package-lock.json
yarn.lock

# git merge leftovers
*.orig

# Impeccable (local design-tool state)
.impeccable/
# The skill itself is installed locally, not vendored. Everything else under
# .claude/ (agents, hooks, settings) IS tracked, so without this line a stray
# `git add -A` sweeps ~100 tool files into an unrelated commit — which is
# exactly how it got into #95.
.claude/skills/impeccable/

# D1 backups (pnpm backup:d1) — plaintext exports of production, never committed
backups/
