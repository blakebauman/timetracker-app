{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timetracker-app",
  "main": "./src/worker/index.ts",
  // Pinned to the installed workerd's date (1.20260708.1), not "today": a
  // compat date ahead of the local runtime makes `wrangler dev` and the e2e
  // suite run on different semantics than the config claims, and warns on every
  // invocation. Bump this together with the workerd/wrangler dependency.
  //
  // Crossing 2026-04-07 turns on `web_socket_auto_reply_to_close`, which is why
  // TimerRoomDO no longer completes the close handshake by hand.
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Explicitly off (wrangler infers false once routes exist, but a config edit
  // could silently re-enable them). A second live origin on *.workers.dev would
  // sit outside trustedOrigins/CORS and split the passkey rpID.
  "workers_dev": false,
  "preview_urls": false,
  // Auto-track: sweep finished Google Calendar events into time entries every 5 min.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Top-level navigations (Sec-Fetch-Mode: navigate) to non-asset paths get the
    // SPA index.html unless the path is routed to the worker here. The Google OAuth
    // callback is a navigation, so without this it never reaches Better Auth.
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "time-tracker",
      "database_id": "d11526a2-6d42-4716-af42-c787aea88fd2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Binding name is unchanged (`env.TIMER_ROOM`), only the class behind
        // it — see the v3 migration for why the class had to be renamed.
        "name": "TIMER_ROOM",
        "class_name": "TimerRoom"
      },
      // Aski chat: one AIChatAgent instance per workspace. Persists conversation
      // history + resumable streams in its own SQLite (hence new_sqlite_classes).
      {
        "name": "CHAT_AGENT",
        "class_name": "ChatAgent"
      }
    ]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["TimerRoomDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatAgent"]
    },
    // v3 — move the timer room off the legacy key-value storage backend.
    //
    // There is no in-place KV→SQLite migration: "You cannot enable a SQLite
    // storage backend on an existing, deployed Durable Object class." The only
    // route today is to delete the namespace and create a new one, and since a
    // class name can't be both deleted and live in the same config, the class
    // had to be renamed (TimerRoomDO → TimerRoom).
    //
    // Safe to delete precisely because this DO has never persisted anything:
    // no ctx.storage access anywhere, D1 is the source of truth, and
    // per-connection state lives in the socket attachment. What it costs is one
    // reconnect — every live socket drops on deploy and the client's 1s→30s
    // backoff picks them back up.
    //
    // Done now rather than later because the window is only free while the DO
    // stays stateless. Do NOT write to ctx.storage in TimerRoom without
    // revisiting this: from that point the same move loses real data.
    //
    // Create and delete are SEPARATE tags applied by SEPARATE deploys, and that
    // is not stylistic. Putting both in one migration is rejected:
    //
    //   Cannot apply --delete-class migration to class 'TimerRoomDO' without
    //   also removing the binding that references it. [code: 10061]
    //
    // The delete is validated against the bindings of the *currently deployed*
    // script, not the one being uploaded — so the binding has to already point
    // at TimerRoom in a live deploy before TimerRoomDO can be dropped. v3 does
    // the create + rebind; v4 drops the orphan afterwards.
    {
      "tag": "v3",
      "new_sqlite_classes": ["TimerRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "timetracker.run",
      "custom_domain": true
    }
  ]
}
