{
	"name": "timetracker-app",
	"version": "0.0.0",
	"private": true,
	"description": "Time tracking app built on Cloudflare Workers, Hono, React 19, and shadcn/ui",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "lefthook install",
		"dev": "turbo run dev --filter='./apps/*'",
		"dev:web": "pnpm --filter @timetracker/web dev",
		"build": "turbo run build",
		"build:ext": "pnpm --filter @timetracker/extension build",
		"zip:ext": "pnpm --filter @timetracker/extension zip",
		"ext:id": "pnpm --filter @timetracker/extension ext:id",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"check": "pnpm --filter @timetracker/web check",
		"deploy": "turbo run deploy",
		"cf-typegen": "pnpm --filter @timetracker/web cf-typegen",
		"preview": "pnpm --filter @timetracker/web preview",
		"test:e2e": "pnpm --filter @timetracker/web test:e2e",
		"email:dev": "pnpm --filter @timetracker/web email:dev",
		"seed:demo": "node scripts/seed-feature-demo.mjs",
		"generate-icons": "node scripts/generate-icons.mjs",
    "backup:d1": "node scripts/backup-d1.mjs"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@timetracker/core": "workspace:*",
		"@timetracker/eslint-config": "workspace:*",
		"eslint": "catalog:",
		"jiti": "catalog:",
		"lefthook": "catalog:",
		"sharp": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
