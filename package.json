		"@tailwindcss/vite": "^4.3.2",
		"@types/chrome": "^0.2.2",
		"@types/node": "26.1.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"eslint": "10.7.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.3",
		"globals": "17.7.0",
		"jiti": "^2.7.0",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.3.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.64.0",
		"vite": "^8.1.4",
		"wrangler": "4.110.0"
	},
	"private": true,
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsc -b && vite build",
		"build:ext": "cd extension && vite build && cp manifest.json ../dist/extension/ && cp -r icons ../dist/extension/ 2>/dev/null || true",
		"zip:ext": "pnpm build:ext && cd dist/extension && zip -qr -X ../timetracker-extension.zip . -x '.*' && echo 'Wrote dist/timetracker-extension.zip (upload this to the Chrome Web Store)'",
		"ext:id": "openssl rsa -in extension/.keys/extension.pem -pubout -outform DER 2>/dev/null | openssl dgst -sha256 -binary | xxd -p -c 32 | head -c 32 | tr '0-9a-f' 'a-p'; echo",
		"generate-icons": "node scripts/generate-icons.mjs",
		"cf-typegen": "wrangler types",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "pnpm run build && vite preview",
		"test:e2e": "playwright test"
	},
	"type": "module"
}
