{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"globalDependencies": ["packages/tsconfig/*.json", "pnpm-workspace.yaml", "package.json", ".npmrc"],
	"globalPassThroughEnv": ["CI", "CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".wrangler/deploy/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"lint": {
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"deploy": {
			"dependsOn": ["build"],
			"cache": false
		}
	}
}
