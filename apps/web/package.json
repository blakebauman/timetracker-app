{
	"name": "@timetracker/web",
	"version": "0.0.0",
	"private": true,
	"description": "Time Tracker SPA (React 19 + Vite) and Hono API served from one Cloudflare Worker.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "pnpm build && vite preview",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"check": "tsc -b && vite build && node ../../scripts/assert-no-secrets-in-client.mjs && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"test:e2e": "playwright test",
		"email:dev": "email dev --dir src/worker/emails --port 3333"
	},
	"dependencies": {
		"@ai-sdk/react": "catalog:",
		"@better-auth/passkey": "catalog:",
		"@cloudflare/ai-chat": "catalog:",
		"@fontsource-variable/geist": "catalog:",
		"@fontsource-variable/geist-mono": "catalog:",
		"@fullcalendar/core": "catalog:",
		"@fullcalendar/daygrid": "catalog:",
		"@fullcalendar/interaction": "catalog:",
		"@fullcalendar/react": "catalog:",
		"@fullcalendar/timegrid": "catalog:",
		"@hono/zod-validator": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-query-devtools": "catalog:",
		"@timetracker/core": "workspace:*",
		"agents": "catalog:",
		"ai": "catalog:",
		"better-auth": "catalog:",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"cmdk": "catalog:",
		"date-fns": "catalog:",
		"hono": "catalog:",
		"idb": "catalog:",
		"lucide-react": "catalog:",
		"mimetext": "catalog:",
		"next-themes": "catalog:",
		"qrcode": "catalog:",
		"radix-ui": "catalog:",
		"react": "catalog:",
		"react-day-picker": "catalog:",
		"react-dom": "catalog:",
		"react-email": "catalog:",
		"react-hotkeys-hook": "catalog:",
		"react-router-dom": "catalog:",
		"recharts": "catalog:",
		"sonner": "catalog:",
		"tailwind-merge": "catalog:",
		"tw-animate-css": "catalog:",
		"use-stick-to-bottom": "catalog:",
